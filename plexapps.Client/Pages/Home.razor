@code{
    [Inject] NavigationManager NavigationManager { get; set; } = default!;
    [Inject] IJSRuntime JSRuntime { get; set; } = default!;

    private int _width = 0;
    private bool _isMobile = false;
    private DotNetObjectReference<Home>? objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            @* _width = await JSRuntime.InvokeAsync<int>("getWindowWidth"); *@
            _width = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth");
            _isMobile = _width <= 800;
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("registerResizeCallback", objRef);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnBrowserResize(int width)
    {
        _width = width;
        _isMobile = _width <= 800;
        StateHasChanged();
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

    void OpenPlex(MouseEventArgs e) => OnClickNavigation(e, "https://plex.hayon.org/");
    void OpenTautulli(MouseEventArgs e) => OnClickNavigation(e, "https://tautulli.hayon.org/");
    void OpenSeerr(MouseEventArgs e) => OnClickNavigation(e, "https://seerr.hayon.org/");
    void OpenRadarr(MouseEventArgs e) => OnClickNavigation(e, "https://radarr.hayon.org/");
    void OpenSonarr(MouseEventArgs e) => OnClickNavigation(e, "https://sonarr.hayon.org/");
    void OpenProwlarr(MouseEventArgs e) => OnClickNavigation(e, "https://prowlarr.hayon.org/");
    void OpenBazarr(MouseEventArgs e) => OnClickNavigation(e, "https://bazarr.hayon.org/");
    void OpenAgregarr(MouseEventArgs e) => OnClickNavigation(e, "https://agregarr.hayon.org/");
    void OpenTunarr(MouseEventArgs e) => OnClickNavigation(e, "https://tunarr.hayon.org/");
    void OpenCleanUpArr(MouseEventArgs e) => OnClickNavigation(e, "https://cleanuparr.hayon.org/");
    void OpenULDAS(MouseEventArgs e) => OnClickNavigation(e, "https://uldas.hayon.org/");

    void OnClickNavigation(MouseEventArgs e, string url)
    {
        if (e.CtrlKey || e.MetaKey || e.Button == 1 || e.Buttons == 4)
            JSRuntime.InvokeVoidAsync("open", url, "_blank");
        else
            NavigationManager.NavigateTo(url);
    }
}
