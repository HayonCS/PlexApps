        height: fit-content; */
    }
    .card-item:hover {
    /*    color: rgba(0, 110, 255, 0.3); */
    }
    .distribution-list-card-item {
        background-color: transparent;
        transition: background-color 0.2s linear, scale 0.2s linear;
        border-radius: 8px;
        width: fit-content !important;
        height: fit-content;
    }

    .card-item-card {
        width: 210px;
        background-color: transparent;
        box-shadow: none;
    }
    .card-item-button {
        padding: 0;
        border-radius: 8px;
        align-items: start;

        width: -moz-available;          /* Firefox */
        width: -webkit-fill-available;  /* Safari & Older Chrome */
        width: stretch;                 /* Chromium 138+, WebKit modern */

        height: -moz-available;          /* Firefox */
        height: -webkit-fill-available;  /* Safari & Older Chrome */
        height: stretch;                 /* Chromium 138+, WebKit modern */
        max-height: none;
    }
    .card-item-content {
        display: flex;
        flex-direction: column;
        align-items: start;
        text-align: start;
    }
</style>

