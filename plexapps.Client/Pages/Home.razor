@code{
    [Inject] NavigationManager NavigationManager { get; set; } = default!;
    [Inject] IJSRuntime JSRuntime { get; set; } = default!;

    private bool _loading = true;

    private int _iconSize = 170;
    private int _gridItemSize = 6;

    private int _width = 0;
    private bool _isMobile = false;
    private string _appSize = "lg";
    private DotNetObjectReference<Home>? objRef;

    private string _urlPlex = "https://plex.hayon.org/";
    private string _urlTautulli = "https://tautulli.hayon.org/";
    private string _urlSeerr = "https://seerr.hayon.org/";
    private string _urlRadarr = "https://radarr.hayon.org/";
    private string _urlSonarr = "https://sonarr.hayon.org/";
    private string _urlProwlarr = "https://prowlarr.hayon.org/";
    private string _urlBazarr = "https://bazarr.hayon.org/";
    private string _urlAgregarr = "https://agregarr.hayon.org/";
    private string _urlTunarr = "https://tunarr.hayon.org/";
    private string _urlCleanuparr = "https://cleanuparr.hayon.org/";
    private string _urlULDAS = "https://uldas.hayon.org/";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _width = await JSRuntime.InvokeAsync<int>("browserResize.getWidth");
            DetermineAppSize(_width);
            objRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("browserResize.registerResizeCallback", objRef);
            _loading = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnBrowserResize(int width)
    {
        DetermineAppSize(width);
        StateHasChanged();
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

    private void DetermineAppSize(int width)
    {
        _width = width;
        _isMobile = _width < 960;

        if (_isMobile)
            _iconSize = 120;
        else
            _iconSize = 170;

        if (width < 550)
        {
            _appSize = "xxs";
            _gridItemSize = 6;
        }
        else if (width < 700)
        {
            _appSize = "xs";
            _gridItemSize = 4;
        }
        else if (width < 960)
        {
            _appSize = "sm";
            _gridItemSize = 3;
        }
        else if (width < 1150)
        {
            _appSize = "md";
            _gridItemSize = 4;
        }
        else if (width < 1600)
        {
            _appSize = "lg";
            _gridItemSize = 3;
        }
        else if (width < 2900)
        {
            _appSize = "xl";
            _gridItemSize = 2;
        }
        else
        {
            _appSize = "xxl";
            _gridItemSize = 1;
        }
    }
}
