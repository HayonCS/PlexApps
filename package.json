{
  "name": "opsmanager",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": "24.14.1"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "plugin:storybook/recommended"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "browser": {
    "child_process": false
  },
  "scripts": {
    "start": "nf start web=1,worker=1",
    "test:jsdom": "NODE_ENV=test vitest --run --config vite/vitest.config.mjs --project jsdom",
    "test:node": "NODE_ENV=test vitest --run --config vite/vitest.config.mjs --project node --no-file-parallelism",
    "test:visual": "NODE_ENV=test vitest --config vite/vitest.config.mjs --ui",
    "test": "yarn test:jsdom && yarn test:node",
    "playwright:codegen": "concurrently \"yarn dev\" \"npx playwright codegen --load-storage=auth-state.json\"",
    "playwright:test": "npx playwright test --reporter=line",
    "build:jsonschema": "node scripts/json-schema-types.js",
    "build:graphql": "gql-gen -o",
    "build:client": "NODE_OPTIONS=--openssl-legacy-provider tsc --noEmit && vite build --config ./vite/client.config.mjs",
    "build:server": "NODE_OPTIONS=--openssl-legacy-provider tsc --noEmit && vite build --config ./vite/server.config.mjs",
    "build:gen": "concurrently \"yarn build:jsonschema\" \"yarn build:graphql\"",
    "build:app": "concurrently \"yarn build:client\" \"yarn build:server\"",
    "build": "yarn build:gen && yarn build:app",
    "build:local": "cross-env NODE_ENV=production AUTH_LOCAL=true yarn build",
    "build:production": "cross-env NODE_ENV=production AUTH_LOCAL=false yarn build",
    "server:local": "cross-env AUTH_LOCAL=true node dist/server.mjs",
    "server:production": "cross-env AUTH_LOCAL=false PORT=3001 node dist/server.mjs",
    "dev:client": "cross-env NODE_OPTIONS=--max_old_space_size=8192 vite dev --config ./vite/client.config.mjs",
    "dev:server:nodemon": "nodemon -e mjs,ts dist/server.mjs",
    "dev:server:vite": "vite build --watch --config ./vite/server.config.mjs",
    "dev:log": "DEBUG=knex:query,knex:bindings,save,db yarn dev 2>&1 | stdbuf -o0 sed -E \"s/.\\[[0-9]{0,2}m//g\" | tee ~/app/dev.log",
    "dev": "concurrently -p name -c \"white,yellow,magenta,green\" -n \"graphql-types,vite-server,nodemon-server,vite-client\" \"yarn build:graphql\" \"yarn dev:server:vite\" \"yarn dev:server:nodemon\" \"yarn dev:client\"",
    "kill:ports": "sh -c 'for p in 3000 3001; do lsof -ti tcp:$p | xargs -r kill; done'",
    "dev:local": "yarn build:local && yarn server:local",
    "dev:production": "yarn build:production && yarn server:production",
    "dev:storybook": "cross-env NODE_OPTIONS=--openssl-legacy-provider STORYBOOK_MODE=true App_ENDPOINT=prod storybook dev -p 9001 --no-open",
    "checkmem": "sudo NODE_ENV=development node ./dist/scripts/check-memory-usage.js",
    "lint": "eslint 'entry/**/*.ts{,x}' 'modules/**/*.ts{,x}'",
    "lint:fix": "eslint --fix 'entry/**/*.ts{,x}' 'modules/**/*.ts{,x}'",
    "prepush": "yarn prettier && yarn types && yarn lint && yarn spellcheck && yarn graphql-test-coverage",
    "git:setup-hooks": "cd .git/hooks && ln -sf ../../scripts/git-hooks/pre-push pre-push",
    "types": "tsc --noEmit",
    "prettier": "prettier --list-different 'modules/**/*.{ts,tsx,js,jsx}'",
    "prettier:fix": "prettier --write 'modules/**/*.{ts,tsx,js,jsx}'",
    "spellcheck": "cspell --no-summary 'entry/**/*.ts{,x}' 'modules/**/*.ts{,x}' '**/*.md'",
    "redis:flushall": "rdcli -h redis flushall",
    "initial": "yarn db:schema:model && yarn db:create && yarn seed:readme",
    "seed:readme": "echo \"\\e[1;32m⚠ ⚠ ⚠ ⚠ ⚠ NOTICE: If you would like to seed data to the database, please refer to db/SEED-DB-DATA.MD\\e[0m\"",
    "seed": "yarn svn:seed && yarn seed:readme",
    "clean": "yarn db:drop",
    "recreate": "yarn clean && yarn initial",
    "db:schema:model": "dotenv -- sqlcmd -No -d model -i db/ddl/exported_ddl.sql",
    "db:create": "yarn db:create:memorymap && yarn db:create:test",
    "db:create:ci": "yarn db:schema:model && yarn db:create:test",
    "db:create:memorymap": "echo CREATE DATABASE MemoryMap | dotenv -- sqlcmd -No -d master",
    "db:create:test": "yarn db:create:test:memorymap && yarn db:create:test:workers",
    "db:create:test:memorymap": "echo CREATE DATABASE [test-memorymap] | dotenv -- sqlcmd -No -d master",
    "db:create:test:workers": "NODE_ENV=test node --unhandled-rejections=strict ./dist/scripts/make-test-dbs.mjs",
    "db:drop": "yarn db:drop:memorymap && yarn db:drop:test",
    "db:drop:memorymap": "echo DROP DATABASE IF EXISTS MemoryMap | dotenv -- sqlcmd -No -d master",
    "db:drop:test": "yarn db:drop:test:workers && echo DROP DATABASE IF EXISTS test | dotenv -- sqlcmd -No -d master && yarn db:drop:test:memorymap",
    "db:drop:test:memorymap": "echo DROP DATABASE IF EXISTS [test-memorymap] | dotenv -- sqlcmd -No -d master",
    "db:drop:test:workers": "NODE_ENV=test node ./dist/scripts/drop-test-dbs.mjs",
    "setup:commandsetparser": "sudo python3 -m venv /home/dev/app/commandsetparser-venv && sudo /home/dev/app/commandsetparser-venv/bin/python -m pip install -U --index-url https://gpm.gentex.com/pypi/PyPI/simple gentex-devicecomm==2.12.1",
    "setup:commandsetparser:nosudo": "python3 -m venv /usr/src/app/commandsetparser-venv && /usr/src/app/commandsetparser-venv/bin/python -m pip install -U --index-url https://gpm.gentex.com/pypi/PyPI/simple gentex-devicecomm==2.12.1",
    "svn:seed": "NODE_ENV=development node ./dist/scripts/seed-subversion-data.mjs",
    "svn:clean": "sudo NODE_ENV=development node ./dist/scripts/clean-subversion-data.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "graphql-test-coverage": "node ./dist/scripts/graphql-test-coverage.mjs",
    "git:behind": "git fetch && ./scripts/git-branch-status -c"
  },
