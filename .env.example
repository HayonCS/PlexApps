NODE_ENV=development

APP_ENDPOINT=dev

#Database Connection
DATABASE_SERVER=sql-server
DATABASE_NAME=MemoryMap
DATABASE_USER=SA
DATABASE_PASSWORD=YourStrongPassw0rd

#SQLCMD Utility Connection
SQLCMDSERVER=sql-server
SQLCMDDBNAME=MemoryMap
SQLCMDUSER=SA
SQLCMDPASSWORD=YourStrongPassw0rd

#Rest Services
MES_SECURITY_ENDPOINT=http://rest-endpoints:3070/
MES_USER_PICTURE_ENDPOINT=http://rest-endpoints:3070/user/image/
MES_ACTIVE_DIRECTORY_ENDPOINT=http://rest-endpoints:3070/

#Fresh Service
FRESHSERVICE_ENDPOINT=http://rest-endpoints:3070/freshservice/
FRESHSERVICE_API_KEY=Sharingan
FRESHSERVICE_SOFTWARE_CATALOG_ID=214
FRESHSERVICE_ELECTRICAL_CATALOG_ID=216
FRESHSERVICE_VISION_CATALOG_ID=217

#Feature Flags
READ_ONLY_MODE=false
ENABLE_PDF_EXPORT=false

#App Dev Port
PORT=3001
DEV_SERVER_DISABLE_HOST_CHECK=true

#Redis
REDIS_URL=redis://redis:6379/0

#Subversion Client Settings
SVN_USER=user
SVN_PASSWORD=password
SVN_URL=http://subversion/svn/gentex-repo
SVN_REPO=commandsets

SERVER_SECRET=noob_saibot
JWT_SECRET=liu_kang

#Local or Remote Authentication 
AUTH_LOCAL=true

#OAUTH Settings
OAUTH_APP_ID=secret
OAUTH_APP_PASSWORD=secret
OAUTH_TENANT_ID=secret
OAUTH_REDIRECT_URI=http://localhost:3001/auth/callback
OAUTH_SCOPES='profile offline_access user.read calendars.read'
OAUTH_AUTHORITY=https://login.microsoftonline.com/
OAUTH_AUTHORITY_COMMON=https://login.microsoftonline.com/common/
OAUTH_ID_METADATA=v2.0/.well-known/openid-configuration
OAUTH_AUTHORIZE_ENDPOINT=oauth2/v2.0/authorize
OAUTH_TOKEN_ENDPOINT=oauth2/v2.0/token

APP_SPECIFIC_KEYS=--tango1--alpha1--alpha2--

SSL_ENABLED=false
SSL_KEY=sslcert/dev.key
SSL_CERT=sslcert/dev.crt

WEB_ID=undefined
